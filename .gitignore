# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from:
# https://github.com/github/gitignore/blob/main/Unity.gitignore

# =========================
# Unity generated folders
# =========================
.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

*.log

# =========================
# Blender
# =========================
*.blend1
*.blend1.meta

# =========================
# Memory / Recording
# =========================
/[Mm]emoryCaptures/
/[Rr]ecordings/

# =========================
# Asset Store Tools (optional)
# =========================
# /[Aa]ssets/AssetStoreTools*

# =========================
# JetBrains Rider
# =========================
/[Aa]ssets/Plugins/Editor/JetBrains*
*.DotSettings.user
.idea/
*.sln.iml

# =========================
# Visual Studio / VSCode
# =========================
.vs/
.vscode/

# =========================
# Gradle
# =========================
.gradle/

# =========================
# Auto-generated solution/project files
# =========================
ExportedObj/
.consulo/

*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# =========================
# Unity generated meta files
# =========================
*.pidb.meta
*.pdb.meta
*.mdb.meta

# =========================
# Crash reports
# =========================
sysinfo.txt
mono_crash.*
*.stacktrace

# =========================
# Build outputs
# =========================
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# =========================
# Crashlytics
# =========================
crashlytics-build.properties

# =========================
# Unity Test Runner
# =========================
InitTestScene*.unity*
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# =========================
# Addressables
# =========================
/ServerData
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*

# Addressables generated state files
/[Aa]ssets/AddressableAssetsData/*/*.bin*

# =========================
# Visual Scripting
# =========================
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# =========================
# Unity Bee / IL2CPP caches
# =========================
/[Ll]ibrary/Bee/
/[Bb]ee/
/[Ll]ibrary/Il2cppBuildCache/

# =========================
# NuGet
# =========================
.nuget/

# =========================
# VSCode extension local history
# =========================
.history/

# =========================
# macOS / Windows generated files
# =========================
.DS_Store
.DS_Store?
.AppleDouble
.LSOverride

Thumbs.db
Desktop.ini